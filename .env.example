# 复制为 .env 后填写。.env 只保存在你自己电脑上，不要提交到 git。

# DeepSeek（必填）：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 网页界面。默认只监听本机；想用手机在局域网访问就改成 0.0.0.0，并务必设置口令
HOME_AGENT_HOST=127.0.0.1
HOME_AGENT_PORT=8765
HOME_AGENT_UI_TOKEN=

# 微信 ClawBot
WECHAT_ENABLED=1
# 除扫码绑定者以外，还允许谁通过微信使用（微信 user id，逗号分隔）
WECHAT_ALLOW_FROM=

# 联网搜索：默认用 ddgs（多个搜索引擎）。国内网络可设为 bing；有 Tavily key 时优先用 Tavily
WEB_SEARCH_BACKEND=auto
TAVILY_API_KEY=

# 启用的 skill（逗号分隔，默认 webaccess）
HOME_AGENT_SKILLS=webaccess
